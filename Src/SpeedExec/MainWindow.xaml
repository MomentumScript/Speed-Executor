                                               TextAlignment="Center" TextWrapping="Wrap"
                                               Foreground="#FF6A6A6A" FontSize="11.5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="10,0" Visibility="Collapsed" IsHitTestVisible="False" />
                                </Grid>
                            </Grid>
                        </Border>

