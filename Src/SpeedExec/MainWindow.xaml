                                            <Path Fill="#FF969696" Data="M11.9996 15.6299C10.6796 15.6299 9.59961 14.5499 9.59961 13.2299V10.7599C9.59961 9.43989 10.6796 8.35986 11.9996 8.35986C13.3196 8.35986 14.3996 9.43989 14.3996 10.7599V13.2299C14.3996 14.5599 13.3196 15.6299 11.9996 15.6299ZM11.9996 9.86987C11.5096 9.86987 11.0996 10.2699 11.0996 10.7699V13.2399C11.0996 13.7399 11.4996 14.1399 11.9996 14.1399C12.4996 14.1399 12.8996 13.7399 12.8996 13.2399V10.7699C12.8996 10.2699 12.4896 9.86987 11.9996 9.86987Z" />
                                        </Canvas>
                                    </Button>
                                </Grid>
                            </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
            

            
            <Border x:Name="ChatBorder" Margin="70,55,10,10" Background="Transparent" CornerRadius="10" Visibility="Hidden">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                                <Ellipse x:Name="ChatStatus" Width="11" Height="11" Fill="#FF5A5A5A"
                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Model" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox x:Name="ChatModelBox" Width="120" Height="26"
                                         Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource StrokeBrush}"
                                         BorderThickness="1" Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}"
                                         FontSize="12" Padding="4,0" VerticalContentAlignment="Center"
                                         ToolTip="Model name (leave blank for server default)" />
                                <TextBlock Text="Server" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                           VerticalAlignment="Center" Margin="12,0,5,0" />
                                <TextBox x:Name="ChatServerBox" Width="190" Height="26" Text="http://127.0.0.1:8080"
                                         Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource StrokeBrush}"
                                         BorderThickness="1" Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}"
                                         FontSize="12" Padding="4,0" VerticalContentAlignment="Center"
                                         ToolTip="AI server address" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="SetupAiBtn" Content="Setup AI" Click="SetupAiBtn_Click"
                                        Style="{DynamicResource NormalButtonStyle}"
                                        Background="Transparent" BorderBrush="{StaticResource StrokeBrush}"
                                        Foreground="{DynamicResource AccentBrush}"
                                        Width="86" Height="28" Margin="0,0,8,0"
                                        ToolTip="Download and start the local AI server" />
                                <Button x:Name="ChatClearBtn" Content="Clear" Click="ChatClearBtn_Click"
                                        Style="{DynamicResource NormalButtonStyle}"
                                        Background="Transparent" BorderBrush="{StaticResource StrokeBrush}"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Width="70" Height="28" ToolTip="Clear the conversation" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Margin="0,8,0,8" Padding="10">
                        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ChatPanel" />
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10" MinHeight="84">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="86" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <TextBox x:Name="ChatInput"
                                         Background="{StaticResource FieldBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                         CaretBrush="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                         Padding="8,6" FontSize="13" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                         KeyDown="ChatInput_KeyDown" TextChanged="ChatInput_TextChanged" />
                                <TextBlock x:Name="ChatPlaceholder"
                                           Text="Ask Speed Chat to write a script, or say 'make me fly'…"
                                           Foreground="#FF6A6A6A" FontSize="13" Margin="10,8,0,0"
                                           VerticalAlignment="Top" IsHitTestVisible="False" />
                            </Grid>

                            <Button x:Name="SendChatBtn" Grid.Column="1" Content="Send" Click="SendChatBtn_Click"
                                    Style="{DynamicResource NormalButtonStyle}"
                                    Background="Transparent" BorderBrush="{DynamicResource AccentBrush}"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Margin="10,0,0,0" ToolTip="Send (Enter)" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            

            
            <Thumb x:Name="ResizeGrip" Width="18" Height="18"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                   Cursor="SizeNWSE" DragDelta="ResizeGrip_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Path Stroke="#FF4A4A4A" StrokeThickness="1.3"
                              Data="M2 15 L15 2 M6 16 L16 6 M10 16 L16 10" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

        </Grid>
        </Grid>

        <!--#region Clients Overlay (attach flow) -->
        <Grid x:Name="ClientsOverlay" Visibility="Collapsed" Opacity="0" Panel.ZIndex="50">
            <Grid.Resources>

                <!-- Header icon button: background fades in and the glyph pops
                     with a slight overshoot on hover, then settles on the way out. -->
                <Style x:Key="IconBtn" TargetType="{x:Type Button}">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="bd" CornerRadius="7" SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <SolidColorBrush Color="#00FFFFFF" />
                                    </Border.Background>
                                    <ContentPresenter x:Name="cp"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                        <ContentPresenter.RenderTransform>
                                            <ScaleTransform x:Name="cpScale" ScaleX="1" ScaleY="1" />
                                        </ContentPresenter.RenderTransform>
                                    </ContentPresenter>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="bd"
                                                                Storyboard.TargetProperty="Background.Color"
                                                                To="#1FFFFFFF" Duration="0:0:0.16" />
                                                <DoubleAnimation Storyboard.TargetName="cpScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1.18" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="cpScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1.18" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="bd"
                                                                Storyboard.TargetProperty="Background.Color"
                                                                To="#00FFFFFF" Duration="0:0:0.24" />
                                                <DoubleAnimation Storyboard.TargetName="cpScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="cpScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="#33FFFFFF" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Gold primary action button (Inject). Per-instance brush in the
                     template so the hover/press ColorAnimations don't mutate the
                     shared AccentBrush resource. -->
                <Style x:Key="InjectBtn" TargetType="{x:Type Button}">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="#FF1A1A1A" />
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="M21 15 V19 A2 2 0 0 1 19 21 H5 A2 2 0 0 1 3 19 V15 M7 10 L12 15 L17 10 M12 15 V3"
                                          Stroke="#FF1A1A1A" StrokeThickness="2.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform" Width="13" Height="13"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding}" Margin="7,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="bd" CornerRadius="7" SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <SolidColorBrush Color="#FFE8A800" />
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="bd"
                                                                Storyboard.TargetProperty="Background.Color"
                                                                To="#FFFFC61F" Duration="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="bd"
                                                                Storyboard.TargetProperty="Background.Color"
                                                                To="#FFE8A800" Duration="0:0:0.22" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.98" ScaleY="0.96" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="bd" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Neutral ghost button used once a client is already injected. -->
                <Style x:Key="GhostBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource InjectBtn}">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="bd" CornerRadius="7" SnapsToDevicePixels="True"
                                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="#FF232323" />
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="bd"
                                                                Storyboard.TargetProperty="Background.Color"
                                                                To="#FF2D2D30" Duration="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="bd"
                                                                Storyboard.TargetProperty="Background.Color"
                                                                To="#FF232323" Duration="0:0:0.22" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- One client instance. Bound to ClientVm. -->
                <DataTemplate x:Key="ClientRowTemplate">
                    <Border x:Name="row" Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1"
                            CornerRadius="9" Padding="11,10,11,11" Margin="0,0,0,7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- avatar -->
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                    Background="{StaticResource FieldBrush}" ClipToBounds="True"
                                    VerticalAlignment="Center">
                                <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                            </Border>

                            <!-- name + pid -->
                            <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding PidLabel}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="11" Margin="0,1,0,0" />
                            </StackPanel>

                            <!-- status pill -->
                            <Border Grid.Column="2" CornerRadius="9" Padding="9,3,9,4"
                                    VerticalAlignment="Center"
                                    Background="{Binding StatusBg}">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{Binding StatusFg}"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="10" FontWeight="SemiBold" />
                            </Border>

                            <!-- action -->
                            <Button Grid.Row="1" Grid.ColumnSpan="3" Margin="0,11,0,0"
                                    Content="{Binding ActionText}"
                                    IsEnabled="{Binding CanInject}"
                                    Tag="{Binding}"
                                    Click="ClientInject_Click"
                                    Style="{StaticResource InjectBtn}" />
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Injected}" Value="True">
                            <Setter TargetName="row" Property="BorderBrush" Value="#FF3A5C34" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>

                <!-- Section header (Injected / Not injected). -->
                <Style x:Key="SectionHeader" TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Padding" Value="12,9,12,9" />
                </Style>
            </Grid.Resources>

            <!-- Scrim. MainContent is blurred from code-behind; WebView2s are
                 hidden for the duration since a WPF BlurEffect cannot reach
                 their HWND-hosted surface. -->
            <Rectangle Fill="#B8000000" />

            <!-- Warm accent bloom behind the panel. -->
            <Ellipse Width="620" Height="620" HorizontalAlignment="Right"
                     VerticalAlignment="Center" Margin="0,0,-190,0" Opacity="0.28"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                         RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#55E8A800" Offset="0" />
                        <GradientStop Color="#00E8A800" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Border x:Name="ClientsSidebar" Width="352"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Margin="0,12,12,12"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                    CornerRadius="12">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ClientsSidebarSlide" X="380" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="0" Opacity="0.55" />
                </Border.Effect>

                <DockPanel LastChildFill="True" Margin="16,14,16,16">

                    <!-- header -->
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Clients"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Opened instances"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontFamily="{StaticResource UiFont}" FontSize="11" />
                        </StackPanel>

                        <Button Grid.Column="1" Width="28" Height="28"
                                Style="{StaticResource IconBtn}"
                                ToolTip="Refresh" Click="ClientsRefresh_Click">
                            <Path Data="M21 12 A9 9 0 0 0 12 3 A9.75 9.75 0 0 0 5.26 5.74 L3 8 M3 3 V8 H8 M3 12 A9 9 0 0 0 12 21 A9.75 9.75 0 0 0 18.74 18.26 L21 16 M21 21 V16 H16"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform" Width="16" Height="16" />
                        </Button>

                        <Button Grid.Column="2" Width="28" Height="28"
                                Style="{StaticResource IconBtn}"
                                ToolTip="Close" Click="ClientsClose_Click">
                            <Path Data="M18 6 L6 18 M6 6 L18 18"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform" Width="14" Height="14" />
                        </Button>
                    </Grid>

                    <TextBlock x:Name="ClientsInstanceCount" DockPanel.Dock="Top"
                               Text="0 Instances"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="{StaticResource UiFont}" FontSize="12"
                               Margin="0,15,0,11" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,4,0">
                        <StackPanel>

                            <!-- Injected -->
                            <Border Style="{StaticResource SectionHeader}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Data="M20 6 L9 17 L4 12"
                                          Stroke="#FF7BC96F" StrokeThickness="2.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform" Width="15" Height="15"
                                          VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Injected"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontFamily="{StaticResource UiFont}"
                                               FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="9,0,0,0" />
                                    <TextBlock Grid.Column="2" x:Name="InjectedCountLabel" Text="0"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontFamily="{StaticResource UiFont}"
                                               FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ItemsControl x:Name="InjectedItems" Margin="0,9,0,0"
                                          ItemTemplate="{StaticResource ClientRowTemplate}" />

                            <StackPanel x:Name="InjectedEmpty" Margin="0,18,0,18">
                                <Border Width="46" Height="46" CornerRadius="12"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        HorizontalAlignment="Center">
                                    <Path Data="M18 6 L6 18 M6 6 L18 18"
                                          Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform" Width="19" Height="19"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No injected clients"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="12" HorizontalAlignment="Center"
                                           Margin="0,11,0,0" />
                            </StackPanel>

                            <!-- Not injected -->
                            <Border Style="{StaticResource SectionHeader}" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="M18 6 L6 18 M6 6 L18 18"
                                          Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform" Width="14" Height="14"
                                          VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Not injected"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontFamily="{StaticResource UiFont}"
                                               FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="9,0,0,0" />
                                    <TextBlock Grid.Column="2" x:Name="NotInjectedCountLabel" Text="0"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontFamily="{StaticResource UiFont}"
                                               FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ItemsControl x:Name="NotInjectedItems" Margin="0,9,0,0"
                                          ItemTemplate="{StaticResource ClientRowTemplate}" />

                            <TextBlock x:Name="NotInjectedEmpty" Text="No other instances"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontFamily="{StaticResource UiFont}" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,12,0,12"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        <!--#endregion -->

        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Opacity="0">
            <Border CornerRadius="10" Background="#E6101013">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Speed Executor"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="First-time setup"
                                   Foreground="#FF9A9A9A" FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />

                        <Border Width="360" Height="1" Margin="0,22,0,22"
                                Background="#33FFFFFF" />

                        <TextBlock x:Name="LoadingText"
                                   Text="Fetching offsets..."
                                   Foreground="White" FontSize="16"
                                   HorizontalAlignment="Center"
                                   FontFamily="{StaticResource UiFont}" />
                        <ProgressBar x:Name="LoadingBar"
                                     IsIndeterminate="True"
                                     Height="4" Width="260"
                                     Margin="0,18,0,0"
                                     Background="#22FFFFFF"
                                     Foreground="{DynamicResource AccentBrush}"
                                     BorderBrush="Transparent" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </Border>
</Window>
