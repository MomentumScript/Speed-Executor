<Window x:Class="SpeedExecutor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:SpeedExecutor"
        mc:Ignorable="d"
        Title="Speed Executor"
        Height="640" Width="1000"
        MinWidth="820" MinHeight="560"
        AllowsTransparency="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}"
        Loaded="Window_Loaded"
        Icon="/Images/logo.png">

    <Border x:Name="MainBorder" CornerRadius="10" Background="{StaticResource BgBrush}" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <Grid>
        <Grid x:Name="MainContent">
        <Grid x:Name="MainGrid">
            
            <Border x:Name="SideBarBorder" HorizontalAlignment="Left" Width="55" Margin="10,50,0,10"
                    CornerRadius="8" Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <Border x:Name="Indicator"
                            Width="3" Height="22"
                            Margin="5,17,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="2" />

                    <RadioButton x:Name="DashboardBtn" Click="DashboardBtn_Click"
                                 Template="{DynamicResource SideBarBtn}"
                                 Width="36" Height="36" Margin="10,10,0,0"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 IsChecked="True" ToolTip="Dashboard">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#FFE8A800" Opacity="0.4" Data="M6.19 2H17.81C20.17 2 22 3.83 22 6.19V17.81C22 20.17 20.17 22 17.81 22H6.19C3.83 22 2 20.17 2 17.81V6.19C2 3.83 3.83 2 6.19 2Z" />
                            <Path Fill="#292D32" Data="M7 7H17V10.5H7V7Z" />
                            <Path Fill="#292D32" Data="M7 12.5H11V17H7V12.5Z" />
                            <Path Fill="#292D32" Data="M12.5 12.5H17V17H12.5V12.5Z" />
                        </Canvas>
                    </RadioButton>

                    <RadioButton x:Name="EditorBtn" Click="EditorBtn_Click"
                                 Template="{DynamicResource SideBarBtn}"
                                 Width="36" Height="36" Margin="10,50,0,0"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 IsChecked="False" ToolTip="Editor">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#FFE8A800" Opacity="0.4" Data="M22 8V16.19C22 19.83 19.83 22 16.19 22H7.81C4.17 22 2 19.83 2 16.19V8.01L22 8Z" />
                            <Path Fill="#292D32" Data="M9.00094 17.7499C8.89094 17.7499 8.77094 17.7199 8.67094 17.6699C7.90094 17.2799 7.24094 16.6999 6.76094 15.9799C6.36094 15.3799 6.36094 14.6099 6.76094 14.0099C7.24094 13.2899 7.90094 12.7099 8.67094 12.3299C9.04094 12.1399 9.49094 12.2999 9.68094 12.6699C9.87094 13.0399 9.72094 13.4899 9.34094 13.6799C8.80094 13.9499 8.34094 14.3599 8.01094 14.8599C7.95094 14.9499 7.95094 15.0699 8.01094 15.1699C8.34094 15.6699 8.80094 16.0799 9.34094 16.3499C9.71094 16.5399 9.86094 16.9899 9.68094 17.3599C9.54094 17.5999 9.27094 17.7499 9.00094 17.7499Z" />
                            <Path Fill="#292D32" Data="M15.2092 17.7499C14.9292 17.7499 14.6692 17.5999 14.5392 17.3399C14.3492 16.9699 14.4992 16.5199 14.8792 16.3299C15.4192 16.0599 15.8792 15.6499 16.2092 15.1499C16.2692 15.0599 16.2692 14.9399 16.2092 14.8399C15.8792 14.3399 15.4192 13.9299 14.8792 13.6599C14.5092 13.4699 14.3592 13.0199 14.5392 12.6499C14.7292 12.2799 15.1792 12.1299 15.5492 12.3099C16.3192 12.6999 16.9792 13.2799 17.4592 13.9999C17.8592 14.5999 17.8592 15.3699 17.4592 15.9699C16.9792 16.6899 16.3192 17.2699 15.5492 17.6499C15.4292 17.7199 15.3192 17.7499 15.2092 17.7499Z" />
                            <Path Fill="#292D32" Data="M22 7.81V8L2 8.01V7.81C2 4.17 4.17 2 7.81 2H16.19C19.83 2 22 4.17 22 7.81Z" />
                        </Canvas>
                    </RadioButton>

                    <RadioButton x:Name="ScriptHubBtn" Click="ScriptHubBtn_Click"
                                 Template="{DynamicResource SideBarBtn}"
                                 Width="36" Height="36" Margin="10,90,0,0"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 IsChecked="False" ToolTip="Script Hub">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#FFE8A800" Opacity="0.4" Data="M20.17 18.7399C19.13 19.6899 17.77 20.2199 16.35 20.2199H5.97C3.23 20.0199 2 17.9099 2 16.0299C2 15.9299 2 15.8299 2.01 15.7199L20.48 10.6899C21.05 11.2999 21.48 12.0499 21.74 12.9099C22.4 15.0799 21.8 17.3099 20.17 18.7399Z" />
                            <Path Fill="#292D32" Data="M20.4798 10.6901L2.00977 15.7201C2.11977 14.1301 3.10977 12.4601 5.10977 11.9701C4.51977 9.6401 5.01977 7.4501 6.53977 5.8601C8.26977 4.0501 11.0298 3.3301 13.4098 4.0701C15.5998 4.7401 17.1398 6.5401 17.6898 9.0401C18.7798 9.2901 19.7498 9.8601 20.4798 10.6901Z" />
                        </Canvas>
                    </RadioButton>

                    <RadioButton x:Name="SettingsBtn" Click="SettingsBtn_Click"
                                 Template="{DynamicResource SideBarBtn}"
                                 Width="36" Height="36" Margin="10,130,0,0"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 IsChecked="False" ToolTip="Settings">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#FFE8A800" Opacity="0.4" Data="M16.19 2H7.81C4.17 2 2 4.17 2 7.81V16.18C2 19.83 4.17 22 7.81 22H16.18C19.82 22 21.99 19.83 21.99 16.19V7.81C22 4.17 19.83 2 16.19 2Z" />
                            <Path Fill="#292D32" Data="M15.5801 19.2501C15.1701 19.2501 14.8301 18.9101 14.8301 18.5001V14.6001C14.8301 14.1901 15.1701 13.8501 15.5801 13.8501C15.9901 13.8501 16.3301 14.1901 16.3301 14.6001V18.5001C16.3301 18.9101 15.9901 19.2501 15.5801 19.2501Z" />
                            <Path Fill="#292D32" Data="M15.5801 8.2C15.1701 8.2 14.8301 7.86 14.8301 7.45V5.5C14.8301 5.09 15.1701 4.75 15.5801 4.75C15.9901 4.75 16.3301 5.09 16.3301 5.5V7.45C16.3301 7.86 15.9901 8.2 15.5801 8.2Z" />
                            <Path Fill="#292D32" Data="M8.41992 19.2498C8.00992 19.2498 7.66992 18.9098 7.66992 18.4998V16.5498C7.66992 16.1398 8.00992 15.7998 8.41992 15.7998C8.82992 15.7998 9.16992 16.1398 9.16992 16.5498V18.4998C9.16992 18.9098 8.83992 19.2498 8.41992 19.2498Z" />
                            <Path Fill="#292D32" Data="M8.41992 10.15C8.00992 10.15 7.66992 9.81 7.66992 9.4V5.5C7.66992 5.09 8.00992 4.75 8.41992 4.75C8.82992 4.75 9.16992 5.09 9.16992 5.5V9.4C9.16992 9.81 8.83992 10.15 8.41992 10.15Z" />
                            <Path Fill="#292D32" Data="M15.5796 7.33008C14.0796 7.33008 12.8496 8.55008 12.8496 10.0501C12.8496 11.5501 14.0696 12.7801 15.5796 12.7801C17.0796 12.7801 18.2996 11.5601 18.2996 10.0501C18.2996 8.54008 17.0796 7.33008 15.5796 7.33008Z" />
                            <Path Fill="#292D32" Data="M8.41922 11.23C6.91922 11.23 5.69922 12.45 5.69922 13.96C5.69922 15.47 6.91922 16.68 8.41922 16.68C9.91922 16.68 11.1492 15.46 11.1492 13.96C11.1492 12.46 9.92922 11.23 8.41922 11.23Z" />
                        </Canvas>
                    </RadioButton>

                    <RadioButton x:Name="ChatBtn" Click="ChatBtn_Click"
                                 Template="{DynamicResource SideBarBtn}"
                                 Width="36" Height="36" Margin="10,170,0,0"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 IsChecked="False" ToolTip="Speed Chat">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#FFE8A800" Opacity="0.4" Data="M4 3H20C21.1 3 22 3.9 22 5V14C22 15.1 21.1 16 20 16H13.24L9.5 19.5V16H4C2.9 16 2 15.1 2 14V5C2 3.9 2.9 3 4 3Z" />
                            <Path Fill="#292D32" Data="M7 9.5C7.83 9.5 8.5 10.17 8.5 11C8.5 11.83 7.83 12.5 7 12.5C6.17 12.5 5.5 11.83 5.5 11C5.5 10.17 6.17 9.5 7 9.5Z" />
                            <Path Fill="#292D32" Data="M12 9.5C12.83 9.5 13.5 10.17 13.5 11C13.5 11.83 12.83 12.5 12 12.5C11.17 12.5 10.5 11.83 10.5 11C10.5 10.17 11.17 9.5 12 9.5Z" />
                            <Path Fill="#292D32" Data="M17 9.5C17.83 9.5 18.5 10.17 18.5 11C18.5 11.83 17.83 12.5 17 12.5C16.17 12.5 15.5 11.83 15.5 11C15.5 10.17 16.17 9.5 17 9.5Z" />
                        </Canvas>
                    </RadioButton>

                    <Grid x:Name="AvatarHost" Width="32" Height="32" Margin="11,0,0,18"
                          HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          ToolTip="Your Roblox account">
                        <Ellipse x:Name="AvatarRing" Stroke="#FF3C3C3C" StrokeThickness="2" />
                        <Ellipse x:Name="SidebarAvatar" Margin="3" Fill="#FF2A2A2A" />
                        <TextBlock x:Name="SidebarAvatarInitial" Text="?"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#FF6A6A6A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <Ellipse x:Name="StatusDot" Width="9" Height="9"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Fill="#FF5A5A5A" Stroke="#FF232323" StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="1"
                                                  Color="{Binding Fill.Color, ElementName=StatusDot}" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="LogoArea" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="14,-6,0,0"
                    Panel.ZIndex="10" Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Image Source="/Images/logo.png" Height="70" Stretch="Uniform" IsHitTestVisible="False" />
            </Border>
            

            
            <Border x:Name="TopBar" VerticalAlignment="Top" Height="40" Margin="70,10,10,0"
                    CornerRadius="6" Background="{StaticResource SurfaceBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Button x:Name="MinimizeBtn" Click="MinimizeBtn_Click"
                            Style="{DynamicResource TopBarBtn}"
                            Width="30" Height="30" HorizontalAlignment="Right" Margin="0,5,42,0"
                            ToolTip="Minimize">
                        <Viewbox Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#FFB4B4B4" Data="M3 11H21V13H3Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Button x:Name="ExitBtn" Click="ExitBtn_Click"
                            Style="{DynamicResource TopBarBtn}" Tag="close"
                            Width="30" Height="30" HorizontalAlignment="Right" Margin="0,5,5,0"
                            ToolTip="Close">
                        <Viewbox Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#FFD0D0D0"
                                      Data="M12 10.6L6.4 5L5 6.4L10.6 12L5 17.6L6.4 19L12 13.4L17.6 19L19 17.6L13.4 12L19 6.4L17.6 5L12 10.6Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>
            

            
            <Border x:Name="DashboardBorder" Margin="70,55,10,10" Background="Transparent" CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <StackPanel>

                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Margin="3,10,3,0" Padding="18,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="72" Height="72" Margin="0,0,16,0">
                                    <Ellipse x:Name="DashAvatarRing" Stroke="#FF3C3C3C" StrokeThickness="3" />
                                    <Ellipse x:Name="DashAvatar" Margin="3" Fill="#FF2A2A2A" />
                                    <TextBlock x:Name="DashAvatarInitial" Text="?" FontSize="26" FontWeight="SemiBold"
                                               Foreground="#FF6A6A6A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="DashUsername" Text="Not attached" Foreground="White"
                                               FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="DashSubtitle" Text="Attach to Roblox to load your account"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="DashMeta" Text="" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Border x:Name="DashStatusPill" Background="#FF2D2D30" CornerRadius="11" Padding="10,5"
                                            HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="DashStatusDot" Width="8" Height="8" Fill="#FF5A5A5A"
                                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock x:Name="DashStatusText" Text="Not attached"
                                                       Foreground="#FFB0B0B0" FontSize="11.5" />
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="DashAttachBtn" Content="Attach" Click="DashAttachBtn_Click"
                                            Style="{DynamicResource NormalButtonStyle}"
                                            Background="Transparent" BorderBrush="{DynamicResource AccentBrush}"
                                            Foreground="{DynamicResource AccentBrush}"
                                            Width="90" Height="30" Margin="0,10,0,0" HorizontalAlignment="Right"
                                            ToolTip="Attach to the running Roblox client" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Margin="3,0,3,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="SCRIPTS" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="10.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DashScriptsValue" Text="0" Foreground="White"
                                               FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock x:Name="DashScriptsHint" Text="saved in your Scripts folder"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Margin="3,0,3,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="AI SERVER" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="10.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DashAiValue" Text="Offline" Foreground="White"
                                               FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock x:Name="DashAiHint" Text="http://127.0.0.1:8080"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Margin="3,0,3,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="BUILD" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="10.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DashBuildValue" Text="1.0.0" Foreground="White"
                                               FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock x:Name="DashBuildHint" Text="Speed Executor"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Margin="3,10,3,10" Padding="16,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="What's new" Foreground="White" FontSize="15"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" x:Name="DashVersion" Text=""
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel x:Name="ChangelogPanel" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
            

            
            <Border x:Name="EditorBorder" Margin="70,55,10,10" Background="Transparent" CornerRadius="10" Visibility="Hidden">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="150" MinHeight="60" />
                    </Grid.RowDefinitions>

                    
                    <Border Grid.Row="0" Height="42" Margin="0,0,0,5" CornerRadius="6" Background="{StaticResource SurfaceBrush}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Button x:Name="ExecuteBtn" Click="ExecuteBtn_Click" Width="36" Height="36" Margin="6,0,0,0"
                                        Style="{DynamicResource NormalButtonStyle}" ToolTip="Execute (run in Roblox)">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#FF4B4B4B" Data="M18.7 8.97989L4.14 17.7099C4.05 17.3799 4 17.0299 4 16.6699V7.32989C4 4.24989 7.33 2.32989 10 3.86989L14.04 6.19989L18.09 8.53989C18.31 8.66989 18.52 8.80989 18.7 8.97989Z" />
                                        <Path Fill="#FF646464" Opacity="0.4" Data="M18.0907 15.4598L14.0407 17.7998L10.0007 20.1298C8.0907 21.2298 5.8407 20.5698 4.7207 18.9598L5.1407 18.7098L19.5807 10.0498C20.5807 11.8498 20.0907 14.3098 18.0907 15.4598Z" />
                                    </Canvas>
                                </Button>

                                <Button x:Name="ClearBtn" Click="ClearBtn_Click" Width="36" Height="36" Margin="4,0,0,0"
                                        Style="{DynamicResource NormalButtonStyle}" ToolTip="Clear editor">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#FF4B4B4B" Data="M21.0697 5.23C19.4597 5.07 17.8497 4.95 16.2297 4.86V4.85L16.0097 3.55C15.8597 2.63 15.6397 1.25 13.2997 1.25H10.6797C8.34967 1.25 8.12967 2.57 7.96967 3.54L7.75967 4.82C6.82967 4.88 5.89967 4.94 4.96967 5.03L2.92967 5.23C2.50967 5.27 2.20967 5.64 2.24967 6.05C2.28967 6.46 2.64967 6.76 3.06967 6.72L5.10967 6.52C10.3497 6 15.6297 6.2 20.9297 6.73C20.9597 6.73 20.9797 6.73 21.0097 6.73C21.3897 6.73 21.7197 6.44 21.7597 6.05C21.7897 5.64 21.4897 5.27 21.0697 5.23Z" />
                                        <Path Fill="#FF646464" Opacity="0.4" Data="M19.2297 8.14C18.9897 7.89 18.6597 7.75 18.3197 7.75H5.67975C5.33975 7.75 4.99975 7.89 4.76975 8.14C4.53975 8.39 4.40975 8.73 4.42975 9.08L5.04975 19.34C5.15975 20.86 5.29975 22.76 8.78975 22.76H15.2097C18.6997 22.76 18.8398 20.87 18.9497 19.34L19.5697 9.09C19.5897 8.73 19.4597 8.39 19.2297 8.14Z" />
                                        <Path Fill="#FF646464" Data="M9.58008 17C9.58008 16.5858 9.91586 16.25 10.3301 16.25H13.6601C14.0743 16.25 14.4101 16.5858 14.4101 17C14.4101 17.4142 14.0743 17.75 13.6601 17.75H10.3301C9.91586 17.75 9.58008 17.4142 9.58008 17Z" />
                                        <Path Fill="#FF646464" Data="M8.75 13C8.75 12.5858 9.08579 12.25 9.5 12.25H14.5C14.9142 12.25 15.25 12.5858 15.25 13C15.25 13.4142 14.9142 13.75 14.5 13.75H9.5C9.08579 13.75 8.75 13.4142 8.75 13Z" />
                                    </Canvas>
                                </Button>

                                <Button x:Name="OpenFileBtn" Click="OpenFileBtn_Click" Width="36" Height="36" Margin="4,0,0,0"
                                        Style="{DynamicResource NormalButtonStyle}" ToolTip="Open file">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#FF4B4B4B" Data="M22 11.0699V16.6499C22 19.5999 19.6 21.9999 16.65 21.9999H7.35C4.4 21.9999 2 19.5999 2 16.6499V9.43994H21.74C21.89 9.88994 21.97 10.3499 21.99 10.8399C22 10.9099 22 10.9999 22 11.0699Z" />
                                        <Path Fill="#FF646464" Opacity="0.4" Data="M21.74 9.44H2V6.42C2 3.98 3.98 2 6.42 2H8.75C10.38 2 10.89 2.53 11.54 3.4L12.94 5.26C13.25 5.67 13.29 5.73 13.87 5.73H16.66C19.03 5.72 21.05 7.28 21.74 9.44Z" />
                                    </Canvas>
                                </Button>

                                <Button x:Name="SaveFileBtn" Click="SaveFileBtn_Click" Width="36" Height="36" Margin="4,0,0,0"
